{
  "manifest_version": 3,
  "name": "CMS圖書館 · 原生書籤同步助手",
  "version": "1.0.0",
  "description": "將 CMS 圖書館個人書單與 Chrome 原生書籤資料夾無縫雙向同步，支援多階層分類與跨設備同步。",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "host_permissions": [
    "https://cms.thesmart.cc/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cms.thesmart.cc/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "CMS圖書館 書籤同步",
    "default_popup": "popup.html"
  }
}
